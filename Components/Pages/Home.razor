@page "/"
@using SoulWriter.Helpers

<PageTitle>SoulWriter</PageTitle>
<div class="mx-auto mt-6 flex max-w-[90vw] gap-4 px-4">
    <!-- Left: Chat -->
    <div class="flex-[2] flex-col gap-4">
        <div class="h-[75vh] space-y-4 overflow-y-auto rounded-xl border bg-white p-4 shadow" @ref="chatContainerRef">
            @foreach (var msg in Messages)
            {
                <div class="flex @((msg.Sender == "You") ? "justify-end" : "justify-start")">
                    <div class="relative max-w-xl rounded-2xl p-3 shadow @(msg.Sender == "You" ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-900")">

                        @if (!string.IsNullOrEmpty(msg.AgentName))
                        {
                            <span class="absolute right-2 top-1 cursor-pointer rounded bg-purple-200 px-2 py-0.5 text-xs font-semibold text-purple-800"
                                  @onclick="() => ShowReason(msg.AgentName, msg.AgentReason)">
                                @GetAgentLabel(msg.AgentName)
                            </span>
                        }

                        @((MarkupString)MarkdownHelper.ToHtml(msg.Text))
                    </div>
                </div>
            }

            @if (IsLoading)
            {
                <div class="italic text-gray-500">SoulWriter is thinking...</div>
            }

            @if (ShowAgentReason)
            {
                <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-30">
                    <div class="max-w-md rounded-lg bg-white p-6 shadow-lg">
                        <h3 class="mb-2 text-lg font-bold">@SelectedAgentName</h3>
                        <p class="text-sm text-gray-700">@SelectedAgentReason</p>
                        <button class="mt-4 rounded bg-blue-600 px-4 py-1 text-white hover:bg-blue-700"
                                @onclick="() => ShowAgentReason = false">
                            Close
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="mt-2 flex gap-2">
            <textarea @bind="UserInput"
                      @ref="textareaRef"
                      @oninput="AutoResize"
                      @onkeydown="HandleKeyDown"
                      class="max-h-60 flex-1 resize-none overflow-y-auto rounded-lg border p-3 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      rows="1"
                      placeholder="Type a message... (Enter to send, Shift+Enter for newline)">
            </textarea>

            <button class="rounded bg-blue-600 px-4 font-semibold text-white transition hover:bg-blue-700"
                    @onclick="SubmitMessage" disabled="@IsLoading">
                Send
            </button>
        </div>
    </div>

    <!-- Right: Notes -->
    <div class="flex-[1] h-[75vh] flex-col overflow-y-auto rounded-xl border bg-white p-4 shadow">
        <h2 class="text-md mb-1 font-semibold text-gray-700">Your Notes</h2>

        <textarea @bind="UserNotes"
                  class="h-[90%] w-full flex-1 resize-none rounded-md border p-3 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  placeholder="Paste or type your notes here for brainstorming...">
        </textarea>

        <button class="mt-2 self-start rounded bg-blue-600 px-4 font-semibold text-white transition hover:bg-blue-700"
                @onclick="() => UserNotes = string.Empty">
            Clear notes
        </button>
    </div>
</div>


